---
import "../styles/site.css";

const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{frontmatter.title}</title>
  </head>
  <body>
    <main class="content">
      <slot />
    </main>
  </body>
</html>
